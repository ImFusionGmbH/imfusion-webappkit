    "key": "{\"data\":{\"action\":\"Threshold\",\"inputs\":[{\"index\":2,\"role\":\"0\"},{\"index\":0,\"role\":\"1\"}]},\"type\":\"execute_action\"}"
  },
  {
    "name": "an app-only action drops the inputs the client attached",
